datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  RESTOCK
  DAMAGE
  LOSS
  RETURN
  CORRECTION
  OPENING_STOCK
  SALE_DEDUCTION
  OTHER
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  phone              String?
  address            String?
  passwordHash       String
  role               Role       @default(MANAGER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  createdSales   Sale[]          @relation("CreatedSales")
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  purchases      Purchase[]      @relation("CreatedPurchases")
  expenses       Expense[]       @relation("CreatedExpenses")
  payments       PartyPayment[]  @relation("CreatedPayments")

  @@index([email])
  @@index([role])
  @@index([status])
}

model Company {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String?   @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks        WarehouseStock[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  sales         Sale[]

  @@index([isActive])
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive])
}

model Product {
  id           String    @id @default(uuid())
  name         String
  sku          String    @unique
  barcode      String?   @unique
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  unit         String    @default("piece")
  dpRate       Decimal   @default(0.00) @db.Decimal(12, 2)
  costPrice    Decimal   @default(0.00) @db.Decimal(12, 2)
  sellingPrice Decimal   @default(0.00) @db.Decimal(12, 2)
  quantity     Int       @default(0)
  reorderLevel Int       @default(10)
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]
  warehouseStocks WarehouseStock[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([companyId])
  @@index([isActive])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  companyName String?
  phone       String
  email       String?
  address     String?
  openingDue  Decimal  @default(0.00) @db.Decimal(12, 2)
  currentDue  Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]
  payments  PartyPayment[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String
  email      String?
  address    String?
  openingDue Decimal  @default(0.00) @db.Decimal(12, 2)
  currentDue Decimal  @default(0.00) @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales    Sale[]
  payments PartyPayment[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
}

model Purchase {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  supplierName  String?
  paymentType   String   @default("CASH") // CASH, SUPPLIER (Credit)
  totalAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  dueAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  note          String?
  createdById   String
  createdBy     User     @relation("CreatedPurchases", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseItem[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([createdById])
  @@index([createdAt])
}

model PurchaseItem {
  id                String     @id @default(uuid())
  purchaseId        String
  purchase          Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity          Int
  dpRate            Decimal    @default(0.00) @db.Decimal(12, 2)
  commissionPercent Decimal    @default(0.00) @db.Decimal(5, 2)
  purchaseRate      Decimal    @default(0.00) @db.Decimal(12, 2)
  lineTotal         Decimal    @default(0.00) @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@index([warehouseId])
}

model Sale {
  id              String     @id @default(uuid())
  referenceNumber String     @unique
  createdById     String
  createdBy       User       @relation("CreatedSales", fields: [createdById], references: [id])
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id])
  status          SaleStatus @default(COMPLETED)
  paymentType     String     @default("CASH") // CASH, CREDIT
  totalAmount     Decimal    @default(0.00) @db.Decimal(12, 2)
  paidAmount      Decimal    @default(0.00) @db.Decimal(12, 2)
  dueAmount       Decimal    @default(0.00) @db.Decimal(12, 2)
  customerName    String?
  customerPhone   String?
  note            String?
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items SaleItem[]

  @@index([status])
  @@index([createdById])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id           String     @id @default(uuid())
  saleId       String
  sale         Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity     Int
  purchaseCost Decimal    @default(0.00) @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@index([warehouseId])
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("OTHER")
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  note        String?
  createdById String
  createdBy   User     @relation("CreatedExpenses", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([createdById])
}

model PartyPayment {
  id            String    @id @default(uuid())
  receiptNumber String    @unique
  type          String    // CUSTOMER_COLLECTION, SUPPLIER_PAYMENT
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @default("CASH") // CASH, BANK, BKASH, NAGAD, CHEQUE
  referenceNote String?
  createdById   String
  createdBy     User      @relation("CreatedPayments", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([type])
  @@index([customerId])
  @@index([supplierId])
  @@index([createdAt])
}

model StoreSetting {
  id             String   @id @default(uuid())
  storeName      String   @default("M.R. Enterprise")
  proprietor     String   @default("Proprietor")
  phone          String?
  address        String?
  memoFooterNote String?  @default("Thank you for shopping with us!")
  updatedAt      DateTime @updatedAt
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantityBefore Int
  quantityChange Int
  quantityAfter  Int
  referenceType  String?
  referenceId    String?
  reason         String?
  performedById  String
  performedBy    User              @relation(fields: [performedById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([performedById])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}
